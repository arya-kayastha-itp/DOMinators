# ============================================
# WATSONX HACKATHON - ENVIRONMENT VARIABLES
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env (which is in .gitignore)
#    Command: cp .env.example .env
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit the .env file to git
# 4. NEVER share your credentials in code or with AI assistants
#
# ============================================

# IBM Cloud API Key
# Get from: https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=your_api_key_here_DO_NOT_COMMIT

# ============================================
# CLOUD MIGRATION ACCELERATOR — agents (agents/common/aws.py, llm.py)
# ============================================
AWS_REGION=ap-south-1
# Local AWS CLI profile for Account B (target)
TARGET_PROFILE=mig-target
AGENT_RUNNER_ROLE_ARN=arn:aws:iam::<ACCOUNT_B_ID>:role/mig-agent-runner
TF_APPLY_ROLE_ARN=arn:aws:iam::<ACCOUNT_B_ID>:role/mig-tf-apply
# 1 = run terraform with TARGET_PROFILE instead of assuming TF_APPLY_ROLE_ARN
# (mig-tf-apply lacks iam:PassRole until checklist T1-2 lands)
TF_APPLY_USE_PROFILE=1
LEGACY_ROLE_ARN=arn:aws:iam::<ACCOUNT_A_ID>:role/mig-discovery-readonly
# Shared secret for the cross-account AssumeRole — get it from the Account A owner, never commit it
LEGACY_EXTERNAL_ID=<shared-secret>
# gemini | watsonx | bedrock | anthropic | off | mock  (off = rules only, always works)
LLM_BACKEND=off

# Google Gemini (what the demo uses). flash-lite + minimal thinking answers in
# ~1.5 s; the bigger flash models took 6-18 s or returned 503 "high demand".
# Free tier: 15 requests/minute for this model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=minimal

# IBM watsonx.ai. Set PROJECT_ID or SPACE_ID (project wins if both); the
# project must be linked to a watsonx.ai Runtime (WML) instance. With
# LLM_BACKEND=watsonx, a failed call is retried on Gemini if GEMINI_API_KEY is set.
WATSONX_API_KEY=
WATSONX_URL=https://eu-de.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_SPACE_ID=
WATSONX_MODEL_ID=ibm/granite-4-h-small
WATSONX_VERSION=2024-05-01

# Bedrock (blocked in Account B: no Marketplace payment method, checklist T1-3)
LLM_MODEL_ID=global.anthropic.claude-sonnet-4-6
# AWS_BEARER_TOKEN_BEDROCK=
# Comma-separated VPC ids Discovery may scan in Account A. Account A also runs
# unrelated workloads; without this, Discovery would treat them as apps.
LEGACY_VPC_IDS=<legacy-vpc-id>
# Optional. On machines where Python takes tens of seconds to load certifi's CA
# bundle (seen on a managed Windows laptop), boto3 connections go idle and get
# dropped mid-handshake ("SSL: UNEXPECTED_EOF"). Point this at a PEM with only the
# Amazon Trust Services roots (Amazon Root CA 1-4 + Starfield Services Root G2,
# copied out of certifi) — verification stays fully on, loading takes ~1 s.
# AWS_CA_BUNDLE=<path-to-aws-root-cas.pem>


# ============================================
# SECURITY REMINDERS:
# - This .env.example file is safe to commit
# - Your actual .env file is in .gitignore
# - Never hardcode credentials in your code
# - Use process.env.VARIABLE_NAME to access values
# - Never share credentials with AI assistants like Bob
# ============================================
