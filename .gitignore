# ============================================
# CREDENTIALS AND SECRETS (CRITICAL)
# ============================================

# Environment files
.env
.env.*
!.env.example
*.env
env.local
.env.local
.env.*.local

# IBM Cloud credentials
ibmcloud-credentials.json
ibm-credentials.env
*-credentials.json
*apikey*
*api-key*
*api_key*

# Configuration files with credentials
config.json
config.yaml
config.yml
secrets.json
secrets.yaml
secrets.yml
credentials.json
credentials.yaml

# Private keys
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
id_rsa
id_dsa
*.ppk

# Generic credential patterns
*credentials*
*secret*
*password*
*token*

# Database credentials
database.yml
database.json
db-config.*

# ============================================
# DEVELOPMENT FILES
# ============================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv

# Java
*.class
*.jar
*.war
target/
# ...except our own envs/target/ Terraform dir (not a Java build output)
!infra/terraform/envs/target/

# Terraform (local state/config, not the module source)
# NOTE: .terraform.lock.hcl is NOT ignored - Terraform's own guidance is to
# commit it, so every apply picks the same provider versions.
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
backend-config.hcl
crash.log
crash.*.log

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build outputs
dist/
build/
*.log

# Backup files
*.bak
*.tmp
*.temp
*~
.backup/

